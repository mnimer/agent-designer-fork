      "target": "agent_pro_advocate",
      "sourceHandle": "output",
      "targetHandle": "input",
      "animated": true
    },
    {
      "id": "edge_arbiter_to_con",
      "source": "agent_debate_arbiter",
      "target": "agent_con_advocate",
      "sourceHandle": "output",
      "targetHandle": "input",
      "animated": true
    },
    {
