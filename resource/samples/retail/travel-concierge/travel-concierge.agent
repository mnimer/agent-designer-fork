    {
      "id": "node-agent-travel-root",
      "type": "agentNode",
      "position": { "x": 1096, "y": 328 },
      "data": {
        "id": "node-agent-travel-root",
        "name": "root_agent",
        "label": "Travel Concierge (Root Coordinator)",
        "role": "A Travel Concierge using the services of multiple sub-agents across pre-booking and post-booking stages.",
        "description": "Orchestrates trip discovery, flight/hotel planning, payment processing, pre-trip advisories, in-trip monitoring, and post-trip preference learning.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 12,
        "agentKind": "standard",
        "isStartNode": true,
        "systemPrompt": "You are an exclusive Travel Concierge agent.\nYou help users discover their dream vacation, plan flights and hotels, process bookings, prepare for pre-trip requirements, navigate in-trip logistics, and record post-trip preferences.\n\nRouting & Delegation Rules:\n- If the user asks about general knowledge, vacation inspiration, or things to do, delegate to `inspiration_agent`.\n- If the user asks about finding flight deals, making seat selections, finding hotels, or building a full itinerary, delegate to `planning_agent`.\n- If the user is ready to confirm reservations or process payments, delegate to `booking_agent`.\n- If the trip has an upcoming start date (pre-trip phase) or the user asks for visa/medical/advisory/packing updates, delegate to `pre_trip_agent`.\n- If the user is currently on the trip (in-trip phase) or requests booking monitoring (`monitor`) or transit directions (`transport` / `day_of`), delegate to `in_trip_agent`.\n- If the trip is completed (post-trip phase) or the user shares feedback/dietary preferences, delegate to `post_trip_agent`.",
        "tools": [],
        "subAgents": [
          { "agentId": "node-agent-inspiration", "name": "inspiration_agent" },
          { "agentId": "node-agent-planning", "name": "planning_agent" },
          { "agentId": "node-agent-booking", "name": "booking_agent" },
          { "agentId": "node-agent-pretrip", "name": "pre_trip_agent" },
          { "agentId": "node-agent-intrip", "name": "in_trip_agent" },
          { "agentId": "node-agent-posttrip", "name": "post_trip_agent" }
        ],
        "subAgentPattern": "router",
        "memoryType": "in_memory",
        "memoryConfig": { "type": "in_memory", "windowTurns": 20, "maxTokens": 8192 },
        "outputFormat": "text",
        "colorTheme": "purple"
      }
    },
    {
      "id": "node-agent-inspiration",
      "type": "agentNode",
      "position": { "x": 48, "y": 992 },
      "data": {
        "id": "node-agent-inspiration",
        "name": "inspiration_agent",
        "label": "Inspiration Agent",
        "role": "Inspires users with dream vacation destinations, points of interest, and local activities.",
        "description": "Recommends destinations and activities using Google Maps Grounding MCP and curated POI search.",
        "model": "gemini-3.8-flash",
        "temperature": 0.6,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are a travel inspiration agent who helps users find their next dream vacation destinations.\n- Use `place_recommendation` to suggest vacation destinations given vague regional or thematic ideas.\n- Use `poi_suggestions` and `search_places` (Google Maps Grounding MCP) to provide points of interest, ratings, and coordinates once a destination is selected.\n- Once the user wants to plan dates, flights, or hotels, transfer control to `planning_agent`.",
        "tools": [
          {
            "id": "tool-place-rec",
            "name": "place_recommendation",
            "type": "custom",
            "description": "Recommends dream vacation destinations based on region or interest query.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "place_recommendation"
          },
          {
            "id": "tool-poi-suggestions",
            "name": "poi_suggestions",
            "type": "custom",
            "description": "Returns top points of interest and activities for a chosen destination.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "poi_suggestions"
          },
          {
            "id": "tool-search-places",
            "name": "search_places",
            "type": "custom",
            "description": "Geocodes place names and attractions via Google Maps Grounding Lite MCP.",
            "toolMode": "local_file",
            "sourceFile": "./tools/places_toolset.py",
            "functionName": "search_places"
          }
        ],
        "subAgents": [],
        "subAgentPattern": "parallel",
        "memoryType": "in_memory",
        "outputFormat": "text",
        "colorTheme": "blue"
      }
    },
    {
      "id": "node-agent-planning",
      "type": "agentNode",
      "position": { "x": 464, "y": 992 },
      "data": {
        "id": "node-agent-planning",
        "name": "planning_agent",
        "label": "Planning Agent",
        "role": "Finds flights, selects cabin seats, searches boutique hotels, selects rooms, and builds structured JSON itineraries.",
        "description": "Constructs complete travel plans and multi-day itineraries from origin, destination, and dates.",
        "model": "gemini-3.8-flash",
        "temperature": 0.1,
        "maxIterations": 10,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are a travel planning agent who helps users find the best flights, seats, and hotels, and constructs complete multi-day itineraries.\n- Use `flight_search` and `flight_seat_selection` for air travel.\n- Use `hotel_search` and `hotel_room_selection` for boutique and luxury accommodations.\n- Use `create_itinerary` to persist a structured multi-day JSON itinerary.\n- Use `memorize` to record user selections in session state.\n- Do not process payments directly; transfer to `booking_agent` when ready to book.",
        "tools": [
          {
            "id": "tool-flight-search",
            "name": "flight_search",
            "type": "custom",
            "description": "Searches available outbound and return flights with fares.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "flight_search"
          },
          {
            "id": "tool-seat-select",
            "name": "flight_seat_selection",
            "type": "custom",
            "description": "Reserves cabin seats matching window/aisle preference.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "flight_seat_selection"
          },
          {
            "id": "tool-hotel-search",
            "name": "hotel_search",
            "type": "custom",
            "description": "Searches hotels by destination, dates, and neighborhood (e.g., Shibuya).",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "hotel_search"
          },
          {
            "id": "tool-room-select",
            "name": "hotel_room_selection",
            "type": "custom",
            "description": "Selects room category at the chosen hotel.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "hotel_room_selection"
          },
          {
            "id": "tool-create-itinerary",
            "name": "create_itinerary",
            "type": "custom",
            "description": "Constructs a structured JSON multi-day itinerary.",
            "toolMode": "local_file",
            "sourceFile": "./tools/planning_toolset.py",
            "functionName": "create_itinerary"
          },
          {
            "id": "tool-memorize-plan",
            "name": "memorize",
            "type": "custom",
            "description": "Stores selected flight, seat, hotel, and itinerary state.",
            "toolMode": "local_file",
            "sourceFile": "./tools/memory_toolset.py",
            "functionName": "memorize"
          }
        ],
        "subAgents": [],
        "subAgentPattern": "parallel",
        "memoryType": "in_memory",
        "outputFormat": "text",
        "colorTheme": "teal"
      }
    },
    {
      "id": "node-agent-booking",
      "type": "agentNode",
      "position": { "x": 880, "y": 992 },
      "data": {
        "id": "node-agent-booking",
        "name": "booking_agent",
        "label": "Booking & Payment Agent",
        "role": "Confirms reservations and executes payment processing across Apple Pay, Google Pay, and Credit Card.",
        "description": "Handles reservation holds and payment gateway simulation rules.",
        "model": "gemini-3.8-flash",
        "temperature": 0.0,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are the booking agent responsible for completing flight, hotel, and tour bookings.\n1. Call `create_reservation` to generate a unique reservation ID.\n2. Call `payment_choice` to display supported payment methods (1. Apple Pay, 2. Google Pay, 3. Credit Card on file).\n3. Call `process_payment` once the user selects a payment method.\nNote: Apple Pay transactions will decline per gateway rules; prompt the user to switch to Google Pay or Credit Card to complete the booking.",
        "tools": [
          {
            "id": "tool-create-res",
            "name": "create_reservation",
            "type": "custom",
            "description": "Creates a reservation hold and returns a unique reservation_id.",
            "toolMode": "local_file",
            "sourceFile": "./tools/booking_toolset.py",
            "functionName": "create_reservation"
          },
          {
            "id": "tool-payment-choice",
            "name": "payment_choice",
            "type": "custom",
            "description": "Lists available payment options (Apple Pay, Google Pay, Credit Card).",
            "toolMode": "local_file",
            "sourceFile": "./tools/booking_toolset.py",
            "functionName": "payment_choice"
          },
          {
            "id": "tool-process-payment",
            "name": "process_payment",
            "type": "custom",
            "description": "Executes payment transaction (declines Apple Pay; approves Google Pay & Credit Card).",
            "toolMode": "local_file",
            "sourceFile": "./tools/booking_toolset.py",
            "functionName": "process_payment"
          }
        ],
        "subAgents": [],
        "subAgentPattern": "parallel",
        "memoryType": "in_memory",
        "outputFormat": "text",
        "colorTheme": "amber"
      }
    },
    {
