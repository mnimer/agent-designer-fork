      "type": "agentNode",
      "position": { "x": 1296, "y": 992 },
      "data": {
        "id": "node-agent-pretrip",
        "name": "pre_trip_agent",
        "label": "Pre-Trip Preparation Agent",
        "role": "Fetches visa requirements, medical advisories, storm monitoring, and generates packing lists before departure.",
        "description": "Uses Google Search Grounding and packing list synthesis to prepare travelers before departure.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are a pre-trip assistant equipping the traveler with essential updates before departure.\nWhen given the command `update` or asked about pre-trip readiness:\n1. Use `google_search_grounding` (with `bypass_multi_tools_limit=True`) to check visa requirements, medical requirements, travel advisories, and storm updates for the itinerary origin and destination.\n2. Call `what_to_pack` to generate a customized packing list.\n3. Present a structured, easy-to-read pre-trip readiness summary.",
        "tools": [
          {
            "id": "tool_google_search",
            "name": "google_search_grounding",
