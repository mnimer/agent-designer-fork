{
  "version": "1.0.0",
  "name": "Travel Concierge",
  "description": "Multi-agent flight, hotel, and itinerary coordination system building unified travel plans from dates and preferences across pre-booking and post-booking stages.",
  "framework": "google-adk",
  "language": "python",
  "metadata": {
    "author": "Mike Nimer <mikenimer@google.com>",
    "category": "Retail",
    "badge": "Multi-Agent Concierge",
    "iconName": "Compass",
    "color": "purple",
    "features": [
      "Root Travel Concierge coordinating 6 specialized pre-booking and post-booking sub-agents",
      "Google Search Grounding (bypass_multi_tools_limit=True) & Google Maps Grounding MCP",
      "Flight search, seat selection, hotel search, room selection & structured JSON itinerary builder",
      "Simulated payment gateway with Apple Pay decline and Google Pay / Credit Card approval rules",
      "Real-time In-Trip flight/event/weather monitor and Day-Of A-to-B transit logistics",
      "Attached Test Suite Node with 13 automated evaluation test scenarios"
    ]
  },
  "nodes": [
    {
      "id": "node-trigger-travel-chat",
      "type": "triggerNode",
      "position": { "x": 1128, "y": 48 },
      "data": {
        "id": "node-trigger-travel-chat",
        "label": "Traveler Conversational Chat",
        "triggerType": "chat",
        "triggerKind": "chat",
        "description": "Interactive traveler chat session handling trip inspiration, flight/hotel planning, booking, pre-trip checks, in-trip transit, and post-trip feedback.",
        "targetRootAgentId": "node-agent-travel-root",
        "config": {
          "initialMessage": "Plan a 4-day trip to Tokyo for 2 adults departing next Friday with a boutique hotel near Shibuya.",
          "streaming": true,
          "sessionMemory": "in_memory"
        }
      }
    },
    {
