            "prompt": "Provision parent domain 'supply-chain' and child subdomain 'inventory-mgmt' in project 'corp-bi' location 'us-central1'.",
            "inputQuery": "Provision parent domain 'supply-chain' and child subdomain 'inventory-mgmt' in project 'corp-bi' location 'us-central1'.",
            "expectedOutput": "inventory-mgmt",
            "expectedOutputPattern": "(supply-chain|inventory-mgmt|created|provisioned)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-11-subdomain-principal",
            "name": "11. Subdomain Principal Identity Extraction (Step A)",
            "prompt": "Retrieve the Dataplex service identity policyMember for subdomain 'inventory-mgmt' under parent 'supply-chain'.",
            "inputQuery": "Retrieve the Dataplex service identity policyMember for subdomain 'inventory-mgmt' under parent 'supply-chain'.",
            "expectedOutput": "serviceAccount",
            "expectedOutputPattern": "(serviceAccount|policyMember|principal)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-12-table-iam-authorization",
            "name": "12. Table-Level IAM Authorization Dance (Step B)",
            "prompt": "Authorize the subdomain service identity for 'inventory-mgmt' by granting roles/bigquery.metadataViewer on table 'corp-bi.warehouse.stock_levels'.",
            "inputQuery": "Authorize the subdomain service identity for 'inventory-mgmt' by granting roles/bigquery.metadataViewer on table 'corp-bi.warehouse.stock_levels'.",
            "expectedOutput": "metadataViewer",
            "expectedOutputPattern": "(metadataViewer|authorized|granted)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-13-leaf-table-binding",
            "name": "13. Leaf Table Resource Binding (Step C)",
            "prompt": "Bind table '//bigquery.googleapis.com/projects/corp-bi/datasets/warehouse/tables/stock_levels' to subdomain 'inventory-mgmt'.",
            "inputQuery": "Bind table '//bigquery.googleapis.com/projects/corp-bi/datasets/warehouse/tables/stock_levels' to subdomain 'inventory-mgmt'.",
            "expectedOutput": "stock_levels",
            "expectedOutputPattern": "(stock_levels|bound|binding)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-14-markdown-overview-aspect",
            "name": "14. Native Markdown Overview Aspect Publishing",
            "prompt": "Attach a rich Markdown Overview aspect with executive summary and KPI glossary to domain 'supply-chain'.",
            "inputQuery": "Attach a rich Markdown Overview aspect with executive summary and KPI glossary to domain 'supply-chain'.",
            "expectedOutput": "overview",
            "expectedOutputPattern": "(overview|aspect|attached|published)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-15-scoped-search",
            "name": "15. Scoped Semantic Search within Domain Boundaries",
            "prompt": "Search Knowledge Catalog entries for 'stock' strictly within the boundary of domain 'supply-chain'.",
            "inputQuery": "Search Knowledge Catalog entries for 'stock' strictly within the boundary of domain 'supply-chain'.",
            "expectedOutput": "stock",
            "expectedOutputPattern": "(stock|entry|entries|search)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-16-domain-iam-governance",
            "name": "16. Domain IAM Access Governance Grant",
            "prompt": "Grant 'roles/dataplex.dataDomainViewer' on domain 'supply-chain' to user 'analyst-lead@example.com'.",
            "inputQuery": "Grant 'roles/dataplex.dataDomainViewer' on domain 'supply-chain' to user 'analyst-lead@example.com'.",
            "expectedOutput": "roles/dataplex.dataDomainViewer",
            "expectedOutputPattern": "(roles/dataplex.dataDomainViewer|granted|updated policy)",
            "assertionType": "regex"
          },
          {
            "id": "test-kc-17-cascading-teardown",
            "name": "17. Safe Cascading Domain Teardown",
            "prompt": "Safely decommission and teardown domain 'test-staging', unbinding all attached tables and removing child subdomains before deleting the parent domain.",
            "inputQuery": "Safely decommission and teardown domain 'test-staging', unbinding all attached tables and removing child subdomains before deleting the parent domain.",
            "expectedOutput": "tore down",
            "expectedOutputPattern": "(tore down|unbound|deleted|cascading)",
            "assertionType": "regex"
          }
        ]
      }
    },
    {
      "id": "node-agent-kc-orchestrator",
      "type": "agentNode",
      "position": { "x": 680, "y": 328 },
      "data": {
        "id": "node-agent-kc-orchestrator",
        "name": "root_agent",
        "label": "Data Domain Orchestrator",
        "role": "Orchestrates the 5-agent cohort across asset discovery, DDD architectural modeling, provisioning, and governance.",
        "description": "Routes user intents, coordinates discovery, triggers the Human Approval Gate, and delegates tasks to specialized sub-agents.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 12,
        "agentKind": "standard",
        "isStartNode": true,
        "systemPrompt": "You are the Knowledge Catalog Data Domain Orchestrator.\nYou help data leaders, architects, and engineers organize their Google Cloud BigQuery and Dataplex assets into clean, well-governed Data Domains following Domain-Driven Design (DDD).\n\nINPUT COLLECTION & VALUE HANDLING:\n- A target GCP project ID is required for all operations. If the user has not provided a GCP project ID in the conversation, you MUST ask the user to provide it before taking action or delegating.\n- CRITICAL LOCATION ALIGNMENT RULE: In Dataplex / Knowledge Catalog, Data Domains MUST be provisioned in the exact same location (normalized to lowercase, e.g. BigQuery 'US' -> Dataplex 'us', 'EU' -> 'eu', 'us-central1' -> 'us-central1') as the BigQuery datasets they bind. Always use the `dataplex_location` discovered from `list_datasets`. Only default to 'us' when the user has not specified a location and dataset locations have not been discovered yet.\n- NEVER assume, hallucinate, or expect global or environment variables for project IDs, dataset IDs, or domain IDs.\n- When delegating to sub-agents, always pass along the user's project ID and the exact `dataplex_location` of the target datasets.\n\nERROR HANDLING & FAILURE REPORTING:\n- If any tool returns `status: 'error'`, you MUST STOP immediately and report the exact error message and status code to the user.\n- NEVER claim that resources, domains, or bindings were created if an operation failed or returned an error.\n\nCOHORT DELEGATION RULES:\n- When a user asks to inspect datasets, scan projects, or discover tables, delegate to `discovery_agent`.\n- When analyzing tables, proposing domain structures, or designing subdomains, delegate to `architect_agent`.\n- When an architecture proposal is approved and ready to be provisioned, delegate to `provisioner_agent`.\n- When querying catalog entries, managing IAM permissions, or safely tearing down domains, delegate to `governance_agent`.\n- Always ensure the user has reviewed and approved the DDD proposal before mutating GCP resources!",
        "tools": [],
        "subAgents": [
          { "agentId": "node-agent-kc-discovery", "name": "discovery_agent" },
          { "agentId": "node-agent-kc-architect", "name": "architect_agent" },
          { "agentId": "node-agent-kc-provisioner", "name": "provisioner_agent" },
          { "agentId": "node-agent-kc-governance", "name": "governance_agent" }
        ],
        "subAgentPattern": "router",
        "memoryType": "in_memory",
        "memoryConfig": { "type": "in_memory", "windowTurns": 20, "maxTokens": 8192 },
        "outputFormat": "text",
        "colorTheme": "purple"
      }
    },
    {
      "id": "node-agent-kc-discovery",
      "type": "agentNode",
      "position": { "x": 48, "y": 960 },
      "data": {
        "id": "node-agent-kc-discovery",
        "name": "discovery_agent",
        "label": "Catalog Discovery Specialist",
        "role": "Inspects BigQuery datasets, tables, schemas, and classification metadata.",
        "description": "Executes Phase 1 Asset Inventory Discovery across BigQuery datasets, profiling table schemas and row counts.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are the BigQuery Catalog Discovery Specialist.\nYour responsibility is Phase 1 of the Domain Build Protocol: Asset Inventory Discovery.\n\nINPUT COLLECTION & VALUE HANDLING:\n- A target GCP project ID is required. If `project_id` is not provided in the request or conversation history, ask the user directly to provide their GCP Project ID. Do NOT call tools with empty values or look for environment variables.\n\nERROR HANDLING & FAILURE REPORTING:\n- If any tool returns `status: 'error'`, you MUST STOP immediately and report the exact error message and status code to the user.\n- NEVER hallucinate or pretend dataset or table information if an API error occurs.\n\nDISCOVERY PROTOCOL:\n- Given a target GCP project ID and optional dataset ID, discover all physical data assets.\n- Use `list_datasets` to find available datasets and record each dataset's `location` and normalized `dataplex_location` (e.g., BigQuery `'US'` -> Dataplex `'us'`).\n- Use `list_tables` to identify tables and views within each dataset.\n- Use `get_table_schema` to inspect column names, data types, descriptions, and row volumes.\n- Synthesize an inventory summary of tables, their dataset `dataplex_location`, and their semantic fields, then hand off findings to the DDD Architect Agent (`architect_agent`).",
        "tools": [
          {
            "id": "tool-bq-list-datasets",
            "name": "list_datasets",
            "type": "custom",
            "description": "Lists all BigQuery datasets in a GCP project.",
            "toolMode": "local_file",
            "sourceFile": "./tools/bigquery_toolset.py",
            "functionName": "list_datasets"
          },
          {
            "id": "tool-bq-list-tables",
            "name": "list_tables",
            "type": "custom",
            "description": "Lists all tables and views in a BigQuery dataset.",
            "toolMode": "local_file",
            "sourceFile": "./tools/bigquery_toolset.py",
            "functionName": "list_tables"
          },
          {
            "id": "tool-bq-get-schema",
            "name": "get_table_schema",
            "type": "custom",
            "description": "Retrieves column schema fields, data types, and row volume metadata for a table.",
            "toolMode": "local_file",
            "sourceFile": "./tools/bigquery_toolset.py",
            "functionName": "get_table_schema"
          }
        ],
        "subAgents": [],
        "colorTheme": "blue"
      }
    },
    {
      "id": "node-agent-kc-architect",
      "type": "agentNode",
      "position": { "x": 464, "y": 960 },
      "data": {
        "id": "node-agent-kc-architect",
        "name": "architect_agent",
        "label": "DDD Architecture Specialist",
        "role": "Applies Domain-Driven Design (DDD) principles to classify tables into bounded contexts and design hierarchical domain topologies.",
        "description": "Enforces lowest-level leaf subdomain binding rules, prepares dual documentation (plain-text description + rich markdown overview), and manages the approval gate.",
        "model": "gemini-3.8-flash",
        "temperature": 0.4,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are the Principal Data Architect applying Domain-Driven Design (DDD) heuristics.\nYour responsibility is Phase 2 of the Domain Build Protocol: DDD Modeling & Proposal.\n\nINPUT COLLECTION & VALUE HANDLING:\n- Confirm the target GCP project ID and Dataplex location (matching the lowercase `dataplex_location` of the discovered BigQuery datasets, e.g. `'us'` for `'US'` datasets or `'us-central1'` for `'us-central1'` datasets) before finalizing the proposal. If missing, ask the user.\n\nERROR HANDLING & FAILURE REPORTING:\n- If discovery outputs or prior steps encountered errors, do not proceed with assumptions; notify the user immediately.\n\nCRITICAL ARCHITECTURAL RULES:\n1. Lowest-Level (Leaf) Binding Rule:\n   - Physical data resources (tables, views, models) MUST ALWAYS be mapped and bound to the lowest-level (leaf) subdomain where operational ownership sits.\n   - Parent domains serve exclusively as organizational/strategic containers. NEVER assign physical resources directly to a parent domain if child subdomains exist!\n2. In-Place Governance for Shared/Monolithic Datasets:\n   - If tables in a single dataset represent multiple business concepts, keep physical data in place and assign individual tables directly to their specialized subdomains.\n3. Dual-Documentation Standard:\n   - Plain-Text Description: Always generate a concise 1-2 sentence plain-text description (no markdown, no bullets) for catalog navigation cards.\n   - Rich Markdown Overview: Generate a detailed Markdown document with executive scope, bound table directory, and key analytical use cases to be attached as Knowledge Catalog's native Overview aspect.\n4. Bounded Context Classification:\n   - Classify into Source-Oriented (operational) vs Consumer-Oriented (analytical/reporting) contexts.\n5. Location Alignment:\n   - Explicitly state the target Dataplex `location` (e.g. `'us'` when BigQuery datasets are in `'US'`) in the proposal header.\n\nSTOP AND AWAIT USER APPROVAL:\nYou must present the proposal table to the user and await explicit confirmation before any provisioning occurs.",
        "tools": [],
        "subAgents": [],
        "colorTheme": "blue"
      }
    },
    {
      "id": "node-agent-kc-provisioner",
      "type": "agentNode",
      "position": { "x": 880, "y": 960 },
      "data": {
        "id": "node-agent-kc-provisioner",
        "name": "provisioner_agent",
        "label": "Provisioning Specialist",
        "role": "Provisions Dataplex domains/subdomains, populates native Markdown Overviews, and executes table IAM authorization and binding.",
        "description": "Executes pre-flight exclusivity checks, provisions the hierarchy, attaches native Overview aspects, and executes the 3-step leaf table binding dance.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 12,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are the Dataplex Provisioning and Binding Specialist.\nYour responsibility is Phases 3, 4, and 5 of the Domain Build Protocol (executed only AFTER user approval).\n\nINPUT COLLECTION & VALUE HANDLING:\n- Never assume global or environment values for project_id, location, domain_id, or resource URIs. If any required parameter is missing, ask the user to provide it before calling tools.\n- CRITICAL LOCATION RULE: Always pass the lowercase `location` that matches the target BigQuery datasets (e.g. `'us'` when datasets are in multi-region `'US'`, `'eu'` for `'EU'`, or `'us-central1'` for `'us-central1'`). Dataplex domains can only bind BigQuery tables located in the same region/multi-region.\n\nERROR HANDLING & FAILURE REPORTING:\n- If any tool returns `status: 'error'` (such as 400 Bad Request, 403 Forbidden, 404 Not Found, 409 Conflict, or 500), you MUST STOP immediately and report the error message to the user.\n- NEVER state that a domain, subdomain, binding, or overview was created if the corresponding tool call returned `status: 'error'`!\n\nEXECUTION PROTOCOL (BATCHED FOR ZERO-WAIT IAM PROPAGATION):\n1. Check Availability: Call `verify_binding_availability` for each resource in the target `location`.\n2. Provision Hierarchy: Call `create_domain` for parent domains first, and then `create_subdomain` for child subdomains.\n3. Authorize Leaf Subdomain Principals Upfront (Steps A & B):\n   - Step A: Call `get_domain_principal` on each target leaf subdomain to obtain its `policyMember` identity.\n   - Step B: Call `authorize_table` for ALL target tables upfront to grant `roles/bigquery.metadataViewer` to their subdomain principals (starting BigQuery IAM propagation for all tables simultaneously).\n4. Populate Native Markdown Overviews: Call `set_overview` with `content_type='MARKDOWN'` for each domain and subdomain (running this while table IAM policies propagate in the background).\n5. Bind Resources to Leaf Subdomains (Step C): Call `bind_resource` for each table using the fully qualified table URI:\n   `//bigquery.googleapis.com/projects/<PROJECT_ID>/datasets/<DATASET_ID>/tables/<TABLE_ID>`.",
        "tools": [
          {
            "id": "tool-dp-list-domains",
            "name": "list_domains",
            "type": "custom",
            "description": "Lists existing Dataplex Data Domains in a project and location.",
            "toolMode": "local_file",
            "sourceFile": "./tools/dataplex_toolset.py",
            "functionName": "list_domains"
          },
          {
            "id": "tool-dp-create-domain",
            "name": "create_domain",
            "type": "custom",
            "description": "Creates a top-level Dataplex Data Domain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/dataplex_toolset.py",
            "functionName": "create_domain"
          },
          {
            "id": "tool-dp-create-subdomain",
            "name": "create_subdomain",
            "type": "custom",
            "description": "Creates a child subdomain nested under a parent Dataplex domain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/dataplex_toolset.py",
            "functionName": "create_subdomain"
          },
          {
            "id": "tool-dp-get-principal",
            "name": "get_domain_principal",
            "type": "custom",
            "description": "Extracts the policyMember service account identity from a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/dataplex_toolset.py",
            "functionName": "get_domain_principal"
          },
          {
            "id": "tool-bq-authorize-table",
            "name": "authorize_table",
            "type": "custom",
            "description": "Performs granular table-level IAM authorization dance granting metadataViewer to a domain principal.",
            "toolMode": "local_file",
            "sourceFile": "./tools/bigquery_toolset.py",
            "functionName": "authorize_table"
          },
          {
            "id": "tool-bq-authorize-dataset",
            "name": "authorize_dataset",
            "type": "custom",
            "description": "Authorizes a domain principal on a BigQuery dataset.",
            "toolMode": "local_file",
            "sourceFile": "./tools/bigquery_toolset.py",
            "functionName": "authorize_dataset"
          },
          {
            "id": "tool-dp-bind-resource",
            "name": "bind_resource",
            "type": "custom",
            "description": "Binds a BigQuery table or dataset resource to a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/binding_toolset.py",
            "functionName": "bind_resource"
          },
          {
            "id": "tool-dp-verify-availability",
            "name": "verify_binding_availability",
            "type": "custom",
            "description": "Checks across all domains to verify a resource URI is not already bound (1:1 exclusivity rule).",
            "toolMode": "local_file",
            "sourceFile": "./tools/binding_toolset.py",
            "functionName": "verify_binding_availability"
          },
          {
            "id": "tool-kc-set-overview",
            "name": "set_overview",
            "type": "custom",
            "description": "Attaches a rich Markdown Overview aspect to a Knowledge Catalog domain entry.",
            "toolMode": "local_file",
            "sourceFile": "./tools/overview_toolset.py",
            "functionName": "set_overview"
          }
        ],
        "subAgents": [],
        "colorTheme": "blue"
      }
    },
    {
      "id": "node-agent-kc-governance",
      "type": "agentNode",
      "position": { "x": 1296, "y": 960 },
      "data": {
        "id": "node-agent-kc-governance",
        "name": "governance_agent",
        "label": "Governance Specialist",
        "role": "Manages domain IAM permissions, executes scoped semantic searches, and performs safe cascading teardowns.",
        "description": "Audits domain IAM policies, searches bound entries within domain boundaries, and executes safe cascading teardowns.",
        "model": "gemini-3.8-flash",
        "temperature": 0.2,
        "maxIterations": 8,
        "agentKind": "standard",
        "isStartNode": false,
        "systemPrompt": "You are the Knowledge Catalog Governance and Access Specialist.\nYour responsibility is Phase 6 Validation, Governance & Teardowns.\n\nINPUT COLLECTION & VALUE HANDLING:\n- If project_id, location, or domain_id are missing, ask the user to provide them before executing operations. Never assume global or environment values.\n\nERROR HANDLING & FAILURE REPORTING:\n- If any tool raises an error, you MUST report the exact error to the user and halt further cascading actions.\n- NEVER assume an IAM policy was updated or a domain was torn down if the tool raised an exception.\n\nOPERATIONAL RULES:\n- Use `search_entries` with a domain filter to verify discoverability of bound tables.\n- Use `get_iam_policy` and `add_iam_member` to grant domain access (e.g., `roles/dataplex.dataDomainViewer`).\n- Use `cascading_teardown_domain` when decommissioning a domain, which safely unbinds all tables, deletes child subdomains, and deletes the parent domain.",
        "tools": [
          {
            "id": "tool-dp-get-iam",
            "name": "get_iam_policy",
            "type": "custom",
            "description": "Retrieves the IAM policy for a Dataplex Data Domain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/governance_toolset.py",
            "functionName": "get_iam_policy"
          },
          {
            "id": "tool-dp-add-iam",
            "name": "add_iam_member",
            "type": "custom",
            "description": "Adds an IAM member role to a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/governance_toolset.py",
            "functionName": "add_iam_member"
          },
          {
            "id": "tool-kc-search-entries",
            "name": "search_entries",
            "type": "custom",
            "description": "Executes semantic searches in Knowledge Catalog scoped strictly to domain context.",
            "toolMode": "local_file",
            "sourceFile": "./tools/governance_toolset.py",
            "functionName": "search_entries"
          },
          {
            "id": "tool-dp-cascading-teardown",
            "name": "cascading_teardown_domain",
            "type": "custom",
            "description": "Safely tears down a domain by recursively unbinding all resources and deleting subdomains before removing the domain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/governance_toolset.py",
            "functionName": "cascading_teardown_domain"
          },
          {
            "id": "tool-dp-list-bindings",
            "name": "list_bindings",
            "type": "custom",
            "description": "Lists all resources bound to a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/binding_toolset.py",
            "functionName": "list_bindings"
          },
          {
            "id": "tool-dp-unbind-resource",
            "name": "unbind_resource",
            "type": "custom",
            "description": "Unbinds a resource from a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/binding_toolset.py",
            "functionName": "unbind_resource"
          },
          {
            "id": "tool-dp-delete-domain",
            "name": "delete_domain",
            "type": "custom",
            "description": "Deletes a Dataplex domain or subdomain.",
            "toolMode": "local_file",
            "sourceFile": "./tools/dataplex_toolset.py",
            "functionName": "delete_domain"
          }
        ],
        "subAgents": [],
        "colorTheme": "blue"
      }
    }
  ],
