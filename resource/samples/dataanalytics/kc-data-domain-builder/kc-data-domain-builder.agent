{
  "schemaVersion": "1.0.0",
  "name": "Data Domain Builder",
  "description": "Multi-agent architecture applying Domain-Driven Design (DDD) to discover BigQuery assets, propose bounded contexts, provision Dataplex domains/subdomains, enforce leaf binding rules, and manage data governance.",
  "framework": "google-adk",
  "language": "python",
  "metadata": {
    "category": "Data Governance",
    "badge": "Multi-Agent DDD",
    "author": "Steve Thill <stevethill@google.com>",
    "features": [
      "Domain-Driven Design (DDD) Modeling",
      "Lowest-Level Leaf Subdomain Binding",
      "In-Place Governance for Shared Datasets",
      "Granular BigQuery Table IAM Dance",
      "Native Markdown Overview Aspects",
      "Scoped Semantic Search",
      "Safe Cascading Teardown"
    ]
  },
  "nodes": [
    {
      "id": "node-trigger-kc-chat",
      "type": "triggerNode",
      "position": { "x": 712, "y": 48 },
      "data": {
        "id": "node-trigger-kc-chat",
        "name": "chat_trigger",
        "label": "Interactive Chat Trigger",
        "triggerType": "chat",
        "triggerKind": "chat",
        "description": "Standard interactive chat interface for data architects and engineers.",
        "targetRootAgentId": "node-agent-kc-orchestrator",
        "config": {
          "initialMessage": "Scan project 'analytics-core-prod' in 'us-central1' and propose a Domain-Driven Design hierarchy for our datasets.",
          "streaming": true,
          "sessionMemory": "in_memory"
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": { "type": "string" },
            "project_id": { "type": "string" },
            "location": { "type": "string" }
          },
          "required": ["message"]
        }
      }
    },
    {
      "id": "node-trigger-kc-tester",
      "type": "triggerNode",
      "position": { "x": 256, "y": 360 },
      "data": {
        "id": "node-trigger-kc-tester",
        "name": "eval_tester",
        "label": "Data Domain Test Suite (17 Scenarios)",
        "triggerType": "tester",
        "triggerKind": "tester",
        "description": "Automated evaluation suite with 17 scenarios covering asset discovery, DDD classification, leaf binding compliance, table IAM authorization, overview aspects, scoped search, and cascading teardown.",
        "targetRootAgentId": "node-agent-kc-orchestrator",
        "config": {
          "testScenarios": [
            {
              "id": "test-kc-01-cold-start",
              "name": "1. Cold Start Project Asset Discovery",
              "prompt": "Scan project 'analytics-core-prod' in 'us-central1' and discover all available BigQuery datasets and tables.",
              "inputQuery": "Scan project 'analytics-core-prod' in 'us-central1' and discover all available BigQuery datasets and tables.",
              "expectedOutput": "analytics-core-prod",
              "expectedOutputPattern": "(analytics-core-prod|dataset|table)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-02-schema-profiling",
              "name": "2. Deep Schema & Column Metadata Profiling",
              "prompt": "Inspect the schema and column definitions for table 'analytics-core-prod.retail_dw.customer_orders' including row volumes.",
              "inputQuery": "Inspect the schema and column definitions for table 'analytics-core-prod.retail_dw.customer_orders' including row volumes.",
              "expectedOutput": "schema",
              "expectedOutputPattern": "(schema|column|type|customer_orders)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-03-bounded-context-proposal",
              "name": "3. Bounded Context Classification & DDD Proposal",
              "prompt": "Analyze tables in dataset 'retail_dw' and propose a Domain-Driven Design hierarchy separating operational customer data from financial analytics.",
              "inputQuery": "Analyze tables in dataset 'retail_dw' and propose a Domain-Driven Design hierarchy separating operational customer data from financial analytics.",
              "expectedOutput": "Source-Oriented",
              "expectedOutputPattern": "(Source-Oriented|Consumer-Oriented|bounded context)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-04-leaf-binding-rule",
              "name": "4. Lowest-Level (Leaf) Subdomain Binding Rule Check",
              "prompt": "In a hierarchy with parent domain 'sales-operations' and subdomains 'leads' and 'closed-deals', where should physical table 'dim_sales_leads' be bound?",
              "inputQuery": "In a hierarchy with parent domain 'sales-operations' and subdomains 'leads' and 'closed-deals', where should physical table 'dim_sales_leads' be bound?",
              "expectedOutput": "leaf",
              "expectedOutputPattern": "(leaf|leads)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-05-parent-violation-guard",
              "name": "5. Parent Domain Physical Binding Violation Guard",
              "prompt": "Can we bind the BigQuery table 'orders' directly to the parent container domain 'retail-enterprise' when child subdomains 'checkout' and 'returns' exist?",
              "inputQuery": "Can we bind the BigQuery table 'orders' directly to the parent container domain 'retail-enterprise' when child subdomains 'checkout' and 'returns' exist?",
              "expectedOutput": "cannot",
              "expectedOutputPattern": "(cannot|must not|never|leaf|subdomain)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-06-inplace-governance",
              "name": "6. Shared Monolithic Dataset In-Place Governance",
              "prompt": "The dataset 'monolith_dw' contains tables 'users', 'billing_events', and 'warehouse_inventory'. How should we govern them without moving physical data?",
              "inputQuery": "The dataset 'monolith_dw' contains tables 'users', 'billing_events', and 'warehouse_inventory'. How should we govern them without moving physical data?",
              "expectedOutput": "in-place",
              "expectedOutputPattern": "(in-place|without moving|granular|table-level)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-07-dual-documentation",
              "name": "7. Dual-Documentation Standard Verification",
              "prompt": "Draft both a plain-text description and a rich Markdown Overview for the 'supply-chain' domain and its 'logistics' subdomain.",
              "inputQuery": "Draft both a plain-text description and a rich Markdown Overview for the 'supply-chain' domain and its 'logistics' subdomain.",
              "expectedOutput": "Overview",
              "expectedOutputPattern": "(Overview|plain-text|markdown)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-08-human-approval-gate",
              "name": "8. Human Approval Gate Enforcement",
              "prompt": "I want to immediately create 3 domains in project 'corp-bi' without reviewing any proposal. Go ahead and create them now.",
              "inputQuery": "I want to immediately create 3 domains in project 'corp-bi' without reviewing any proposal. Go ahead and create them now.",
              "expectedOutput": "approval",
              "expectedOutputPattern": "(approval|review|confirm|proposal)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-09-binding-exclusivity",
              "name": "9. Pre-Flight 1:1 Binding Exclusivity Collision Check",
              "prompt": "Check whether table '//bigquery.googleapis.com/projects/corp-bi/datasets/crm/tables/accounts' can be bound or if it is already bound to another domain.",
              "inputQuery": "Check whether table '//bigquery.googleapis.com/projects/corp-bi/datasets/crm/tables/accounts' can be bound or if it is already bound to another domain.",
              "expectedOutput": "exclusivity",
              "expectedOutputPattern": "(exclusiv|bound|available|collision)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-10-provision-hierarchy",
              "name": "10. Dataplex Parent & Subdomain Hierarchy Provisioning",
              "prompt": "Provision parent domain 'supply-chain' and child subdomain 'inventory-mgmt' in project 'corp-bi' location 'us-central1'.",
              "inputQuery": "Provision parent domain 'supply-chain' and child subdomain 'inventory-mgmt' in project 'corp-bi' location 'us-central1'.",
              "expectedOutput": "inventory-mgmt",
              "expectedOutputPattern": "(supply-chain|inventory-mgmt|created|provisioned)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-11-subdomain-principal",
              "name": "11. Subdomain Principal Identity Extraction (Step A)",
              "prompt": "Retrieve the Dataplex service identity policyMember for subdomain 'inventory-mgmt' under parent 'supply-chain'.",
              "inputQuery": "Retrieve the Dataplex service identity policyMember for subdomain 'inventory-mgmt' under parent 'supply-chain'.",
              "expectedOutput": "serviceAccount",
              "expectedOutputPattern": "(serviceAccount|policyMember|principal)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-12-table-iam-authorization",
              "name": "12. Table-Level IAM Authorization Dance (Step B)",
              "prompt": "Authorize the subdomain service identity for 'inventory-mgmt' by granting roles/bigquery.metadataViewer on table 'corp-bi.warehouse.stock_levels'.",
              "inputQuery": "Authorize the subdomain service identity for 'inventory-mgmt' by granting roles/bigquery.metadataViewer on table 'corp-bi.warehouse.stock_levels'.",
              "expectedOutput": "metadataViewer",
              "expectedOutputPattern": "(metadataViewer|authorized|granted)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-13-leaf-table-binding",
              "name": "13. Leaf Table Resource Binding (Step C)",
              "prompt": "Bind table '//bigquery.googleapis.com/projects/corp-bi/datasets/warehouse/tables/stock_levels' to subdomain 'inventory-mgmt'.",
              "inputQuery": "Bind table '//bigquery.googleapis.com/projects/corp-bi/datasets/warehouse/tables/stock_levels' to subdomain 'inventory-mgmt'.",
              "expectedOutput": "stock_levels",
              "expectedOutputPattern": "(stock_levels|bound|binding)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-14-markdown-overview-aspect",
              "name": "14. Native Markdown Overview Aspect Publishing",
              "prompt": "Attach a rich Markdown Overview aspect with executive summary and KPI glossary to domain 'supply-chain'.",
              "inputQuery": "Attach a rich Markdown Overview aspect with executive summary and KPI glossary to domain 'supply-chain'.",
              "expectedOutput": "overview",
              "expectedOutputPattern": "(overview|aspect|attached|published)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-15-scoped-search",
              "name": "15. Scoped Semantic Search within Domain Boundaries",
              "prompt": "Search Knowledge Catalog entries for 'stock' strictly within the boundary of domain 'supply-chain'.",
              "inputQuery": "Search Knowledge Catalog entries for 'stock' strictly within the boundary of domain 'supply-chain'.",
              "expectedOutput": "stock",
              "expectedOutputPattern": "(stock|entry|entries|search)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-16-domain-iam-governance",
              "name": "16. Domain IAM Access Governance Grant",
              "prompt": "Grant 'roles/dataplex.dataDomainViewer' on domain 'supply-chain' to user 'analyst-lead@example.com'.",
              "inputQuery": "Grant 'roles/dataplex.dataDomainViewer' on domain 'supply-chain' to user 'analyst-lead@example.com'.",
              "expectedOutput": "roles/dataplex.dataDomainViewer",
              "expectedOutputPattern": "(roles/dataplex.dataDomainViewer|granted|updated policy)",
              "assertionType": "regex"
            },
            {
              "id": "test-kc-17-cascading-teardown",
              "name": "17. Safe Cascading Domain Teardown",
              "prompt": "Safely decommission and teardown domain 'test-staging', unbinding all attached tables and removing child subdomains before deleting the parent domain.",
              "inputQuery": "Safely decommission and teardown domain 'test-staging', unbinding all attached tables and removing child subdomains before deleting the parent domain.",
              "expectedOutput": "tore down",
              "expectedOutputPattern": "(tore down|unbound|deleted|cascading)",
              "assertionType": "regex"
            }
          ]
        },
