{
  "version": "1.0.0",
  "name": "CompanyVerifier",
  "description": "Automated business entity verification. Listens to Pub/Sub registration events, queries Google Search Grounding and Web Page Reader for corporate presence and operational status, and uses prompt reasoning to classify entity legitimacy and category.",
  "framework": "google-adk",
  "language": "python",
  "metadata": {
    "category": "Enterprise Integration & Identity",
    "badge": "Pub/Sub + Search Grounding",
    "features": [
      "GCP Pub/Sub Trigger",
      "Google Search Grounding",
      "Web Scraping / Reader",
      "Automated Tests"
    ]
  },
  "deployment": {
    "outputFolder": "./company_verifier_agent/",
    "includeTests": true,
    "includeDocker": true,
    "useStreaming": true,
    "deploymentTarget": "agent_engine"
  },
  "nodes": [
    {
      "id": "node-trigger-pubsub",
      "type": "trigger",
      "position": { "x": 80, "y": 200 },
      "data": {
        "id": "node-trigger-pubsub",
        "label": "GCP Pub/Sub Inbound",
        "description": "Subscribes to company registration topic: projects/my-project/topics/company-registrations",
        "triggerKind": "pubsub",
        "config": {
          "pubsubTopic": "projects/my-project/topics/company-registrations",
          "pubsubSubscription": "company-verifier-sub",
          "testScenarios": [
            {
              "id": "scenario-1",
              "name": "Legitimate Restaurant Verification",
              "prompt": "{\"company_name\": \"Tartine Bakery\", \"address\": \"600 Guerrero St, San Francisco, CA 94110\", \"claimed_website\": \"https://tartinebakery.com\"}",
              "expectedOutput": "restaurant",
              "assertionType": "contains"
            },
            {
              "id": "scenario-2",
              "name": "Machine Shop Verification",
              "prompt": "{\"company_name\": \"Bay Area Precision Machining\", \"address\": \"2150 Fortune Dr, San Jose, CA 95131\", \"claimed_website\": \"https://bapm-precision.com\"}",
              "expectedOutput": "machine shop",
              "assertionType": "contains"
            }
          ]
        }
      }
    },
    {
      "id": "node-agent-verifier",
      "type": "agentNode",
      "position": { "x": 480, "y": 160 },
      "data": {
        "id": "node-agent-verifier",
        "label": "Company Verifier Agent",
        "role": "Corporate Entity Verification & Categorization",
        "model": "gemini-3.7-flash",
        "temperature": 0.2,
        "agentKind": "standard",
        "isStartNode": true,
        "systemPrompt": "You are the Company Verifier Agent. Validate incoming corporate entities using Google Search and web page content. Classify legitimacy and exact business vertical.",
        "tools": [
          {
            "id": "google_search",
            "name": "google_search",
            "type": "google_search",
            "description": "Ground Gemini responses in real-time Google Search results.",
            "isBuiltin": true,
            "bypass_multi_tools_limit": true
          },
          {
            "id": "load_web_page",
            "name": "load_web_page",
            "type": "load_web_page",
            "description": "Fetches and converts webpage HTML content into clean markdown text.",
            "isBuiltin": true
          }
        ],
        "subAgents": []
      }
    }
  ],
  "edges": [
    {
      "id": "edge-pubsub-to-verifier",
      "source": "node-trigger-pubsub",
      "target": "node-agent-verifier",
      "style": { "stroke": "#f59e0b", "strokeWidth": 2, "strokeDasharray": "5 5" }
    }
  ]
}
