{
  "version": "1.0.0",
  "name": "HighVolumeDocumentAnalyzer",
  "description": "High-Volume Document Analysis Agent querying, auditing, and synthesizing information from large document collections (PDFs, text, HTML) in iterative chunks using Google ADK.",
  "framework": "google-adk",
  "language": "python",
  "nodes": [
    {
      "id": "node-trigger-doc-eval",
      "type": "trigger",
      "position": {
        "x": 80,
        "y": 240
      },
      "data": {
        "id": "node-trigger-doc-eval",
        "label": "Document Query Inbound",
        "description": "Ingests document collection queries, audit requests, and case investigation questions.",
        "triggerKind": "test",
        "config": {
          "testScenarios": [
            {
              "id": "scenario-doc-summarize",
              "name": "Summarize Latest Updates - Collection 12345",
              "prompt": "Please summarize the latest updates for collection 12345",
              "inputQuery": "Please summarize the latest updates for collection 12345",
              "expectedOutput": "summary",
              "expectedOutputPattern": "summary",
              "assertionType": "contains"
            },
            {
              "id": "scenario-doc-search-clause",
              "name": "Targeted Clause Search - Chronological Audit",
              "prompt": "Can you search collection 12345 from the beginning (chronological) to find clause 42?",
              "inputQuery": "Can you search collection 12345 from the beginning (chronological) to find clause 42?",
              "expectedOutput": "clause",
              "expectedOutputPattern": "clause",
              "assertionType": "contains"
            },
            {
              "id": "scenario-doc-continue-batch",
              "name": "Batch Continuation - Next Document Chunk",
              "prompt": "Continue reading the next batch of documents for collection 12345",
              "inputQuery": "Continue reading the next batch of documents for collection 12345",
              "expectedOutput": "batch",
              "expectedOutputPattern": "batch",
              "assertionType": "contains"
            }
          ],
          "testPrompts": [
            {
              "id": "scenario-doc-summarize",
              "name": "Summarize Latest Updates - Collection 12345",
              "prompt": "Please summarize the latest updates for collection 12345",
              "inputQuery": "Please summarize the latest updates for collection 12345",
              "expectedOutput": "summary",
              "expectedOutputPattern": "summary",
              "assertionType": "contains"
            },
            {
              "id": "scenario-doc-search-clause",
              "name": "Targeted Clause Search - Chronological Audit",
              "prompt": "Can you search collection 12345 from the beginning (chronological) to find clause 42?",
              "inputQuery": "Can you search collection 12345 from the beginning (chronological) to find clause 42?",
              "expectedOutput": "clause",
              "expectedOutputPattern": "clause",
              "assertionType": "contains"
            },
            {
              "id": "scenario-doc-continue-batch",
              "name": "Batch Continuation - Next Document Chunk",
              "prompt": "Continue reading the next batch of documents for collection 12345",
              "inputQuery": "Continue reading the next batch of documents for collection 12345",
              "expectedOutput": "batch",
              "expectedOutputPattern": "batch",
              "assertionType": "contains"
            }
          ]
        }
      }
    },
    {
      "id": "node-agent-doc-analyzer",
      "type": "agent",
      "position": {
        "x": 480,
        "y": 240
      },
      "data": {
        "id": "node-agent-doc-analyzer",
        "label": "Document Analyzer Agent",
        "role": "High-Volume Document Auditor & Synthesizer",
        "description": "Analyzes high-volume document collections in iterative chunks, applying text cleaning, pagination control, and chronological/recency sorting.",
        "model": "gemini-3.7-flash",
        "temperature": 0.1,
        "maxIterations": 10,
        "agentKind": "standard",
        "isStartNode": true,
        "systemPrompt": "You are a High-Volume Document Analysis Agent, specialized in auditing large case files or document collections.\nYour task is to answer user questions by iteratively analyzing document batches using the `analyze_document_next_chunk` tool.\n\n**RULES**\n\n1. **TEXT CLEANING:**\n   - The tool returns technical flags such as `PARTIAL_SUMMARY:` or `FINAL_ANSWER:`.\n   - **NEVER** show these flags to the user. Remove them from the response before displaying it.\n\n2. **PARTIAL SUMMARIES (BATCH READING):**\n   - If the tool returns a partial summary, present it in a fluid and conversational manner:\n     \"Here is the summary of the first batch of documents analyzed: [Summary text without the flag]. Would you like me to continue reading the next ones?\"\n\n3. **SEARCH CONTROL (`reset_search`):**\n   - **NEW QUESTION / TOPIC CHANGE:** Use `reset_search=True` to restart the analysis from the first document.\n   - **SAME TOPIC / CONTINUE READING:** Use `reset_search=False` to fetch the next batch of the same case.\n\n4. **SORTING LOGIC:**\n   - For recent updates or current status -> use `sort_order=\"desc\"`.\n   - For historical background or chronological logs -> use `sort_order=\"asc\"`.\n\n5. **FORMATTING:**\n   - Use Markdown to structure your response.\n   - Highlight key findings or specific values (e.g., dates, names, status) to make them easily readable for the user.",
        "tools": [
          {
            "id": "tool-doc-next-chunk",
            "name": "analyze_document_next_chunk",
            "type": "custom",
            "description": "Iterative chunk tool: downloads and analyzes documents in batches, managing progress and session state across collections.",
            "parameters": {
              "collection_id": "Target collection or case file identifier",
              "question": "Specific audit query or summary goal",
              "sort_order": "Sorting order: 'asc' for chronological, 'desc' for most recent first",
              "reset_search": "True to restart search from index 0; False to continue reading next batch"
            },
            "toolMode": "local_file",
            "sourceFile": "./tools/document_toolset.py",
            "functionName": "analyze_document_next_chunk",
            "availableFunctions": [
              "analyze_document_next_chunk"
            ]
          }
        ],
        "subAgents": [],
        "subAgentPattern": "parallel",
        "memoryType": "none",
        "memoryConfig": {
          "type": "none"
        },
        "outputFormat": "text",
        "colorTheme": "teal"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-trigger-to-agent",
      "source": "node-trigger-doc-eval",
      "target": "node-agent-doc-analyzer",
      "label": "Document Audit Request",
      "style": {
        "stroke": "#0d9488",
        "strokeWidth": 2
      }
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "metadata": {
    "createdAt": "2026-09-12T16:00:00Z",
    "updatedAt": "2026-09-12T16:00:00Z",
    "author": "Mike Nimer <mikenimer@google.com>"
  },
  "deployment": {
    "target": "agent_engine",
    "deploymentTarget": "agent_engine",
    "outputFolder": "./high_volume_document_analyzer/",
    "framework": "google-adk",
    "language": "python"
  }
}
