{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode", "react", "react-dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "vscode": ["tests/mocks/vscode.ts"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "mockup"]
}
